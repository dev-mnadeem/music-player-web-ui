# Which catalogue the app reads from: `fixture` (default) or `spotify`.
# The fixture catalogue is generated locally and needs no credentials, which is
# why it is the default — a fresh clone runs and plays audio with this file absent.
NEXT_PUBLIC_CATALOGUE_PROVIDER=fixture

# Only needed when NEXT_PUBLIC_CATALOGUE_PROVIDER=spotify.
#
# This app uses the authorisation-code-with-PKCE flow, which exists precisely so
# that a browser client needs NO client secret. Do not add one here: every
# NEXT_PUBLIC_* value is compiled into the JavaScript bundle and served to
# anyone who opens the page.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
NEXT_PUBLIC_SPOTIFY_AUTH_URL=https://accounts.spotify.com
NEXT_PUBLIC_SPOTIFY_API_URL=https://api.spotify.com

# Public origin of this app. The OAuth redirect URI is derived as
# `${NEXT_PUBLIC_APP_URL}/callback` and must match the one registered with the
# provider exactly.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mood planner implementation. `local` is the only one registered and it runs
# entirely offline.
MOOD_PLANNER=local
