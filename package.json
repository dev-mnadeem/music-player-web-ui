{
  "name": "tonearm",
  "version": "0.1.0",
  "private": true,
  "description": "A catalogue-agnostic music browser and player with a local fixture catalogue.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
